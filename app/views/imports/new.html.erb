<h1>Import Properties from CSV</h1>
<p class="subtitle">Upload a CSV file to preview and onboard property and unit data.</p>

<div class="card">
  <%= form_with url: imports_path, multipart: true do |f| %>
    <div style="margin-bottom: 16px;">
      <%= f.label :file, "Select CSV file", style: "display:block; font-weight:600; margin-bottom:6px;" %>
      <%= f.file_field :file, accept: ".csv",
            style: "display:block; padding:8px; border:1px solid #d1d5db; border-radius:6px; width:100%;" %>
    </div>

    <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:6px; padding:14px; margin-bottom:18px; font-size:13px;">
      <strong>Expected columns</strong> (header row required, order does not matter):
      <ul style="margin:8px 0 0; padding-left:20px;">
        <li><code>building_name</code> — required, used as unique identifier</li>
        <li><code>street_address</code> — required</li>
        <li><code>unit</code> — optional; blank rows create the property with no unit</li>
        <li><code>city</code> — required</li>
        <li><code>state</code> — required, 2-character code (e.g. OH)</li>
        <li><code>zip_code</code> — required, 5-digit or ZIP+4</li>
      </ul>
      <p style="margin:10px 0 0; color:#64748b;">
        A property with multiple units should appear as multiple rows sharing the same
        <code>building_name</code>.
      </p>
    </div>

    <%= f.submit "Upload and Preview", class: "btn btn-primary" %>
  <% end %>
</div>
