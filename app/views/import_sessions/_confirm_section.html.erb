<div id="confirm_section" style="margin-bottom: 16px;">
  <% if session.confirmed? %>
    <%= link_to "View all properties →", properties_path, class: "btn btn-primary" %>
  <% elsif session.pending? %>
    <% if session.confirmable? %>
      <%= button_to "Confirm Import (#{session.active_count} rows)",
            confirm_import_session_path(session),
            method: :post,
            class: "btn btn-primary",
            data: { confirm: "This will write #{session.active_count} rows to the database. Continue?" } %>
    <% else %>
      <button class="btn btn-primary" disabled title="Resolve or dismiss all errors before confirming">
        Confirm Import
      </button>
      <span style="margin-left:10px; font-size:12px; color:#dc2626;">
        <%= session.error_count %> error<%= session.error_count == 1 ? "" : "s" %> must be dismissed before confirming.
      </span>
    <% end %>
  <% end %>
</div>
