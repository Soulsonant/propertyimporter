<h1>All Properties</h1>
<p class="subtitle"><%= @properties.total_count %> properties in the database</p>

<% if @properties.none? %>
  <div class="card" style="text-align:center; color:#64748b; padding:48px;">
    No properties yet. <%= link_to "Import your first CSV →", new_import_path %>
  </div>
<% else %>
  <div class="card" style="padding:0; overflow:hidden;">
    <table>
      <thead>
        <tr>
          <th>Building Name</th>
          <th>Address</th>
          <th>City</th>
          <th>State</th>
          <th>ZIP</th>
          <th>Units</th>
          <th>Added</th>
        </tr>
      </thead>
      <tbody>
        <% @properties.each do |property| %>
          <tr>
            <td><%= link_to property.name, property_path(property), style: "font-weight:600; text-decoration:none; color:#1d4ed8;" %></td>
            <td><%= property.street_address %></td>
            <td><%= property.city %></td>
            <td><%= property.state %></td>
            <td><%= property.zip_code %></td>
            <td><%= property.units.size %></td>
            <td style="color:#94a3b8; font-size:12px;"><%= property.created_at.strftime("%b %d, %Y") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= paginate @properties %>
<% end %>
